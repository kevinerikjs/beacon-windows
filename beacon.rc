// The app icon (Explorer, taskbar, Alt+Tab, the tray, the pairing window) and the name Task Manager shows.
1 ICON "assets/beacon.ico"

1 VERSIONINFO
FILEVERSION VERSION
PRODUCTVERSION VERSION
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Beacon"
      VALUE "ProductName", "Beacon"
      VALUE "OriginalFilename", "beacon.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
